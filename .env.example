# cp .env.example .env  후 값을 채운다. .env는 커밋되지 않는다.
# 값에 공백·$·따옴표가 들어가면 작은따옴표로 감쌀 것:  KEY='va$lue'
# 값 뒤에 주석(#)을 같은 줄에 붙이지 말 것.

# Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=

# OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=

# 선택. 없으면 60회/시간, 넣으면 5000회/시간.
# 공개 repo만 읽으므로 fine-grained PAT의 "Public Repositories (read-only)"면 충분.
GITHUB_TOKEN=

# 3단계 쓰기 토큰. 위 GITHUB_TOKEN과 반드시 다른 토큰이어야 한다 — 읽기 클라이언트가
# 쓰기 권한에 손댈 수 없게 하는 게 이 분리의 전부다.
#
# github.com/settings/personal-access-tokens → Fine-grained token
#   Repository access: Only select repositories → memories 하나만
#   Permissions: Contents = Read and write
#                Pull requests = Read and write
#                Metadata = Read-only (자동으로 켜진다)
#   그 외에는 아무것도 켜지 말 것. 특히 Administration, Actions, Workflows.
#
# 비워두면 봇은 PR을 못 열고 질문에만 답한다. 배포는 그대로 된다.
GITHUB_WRITE_TOKEN=

# 2단계 자연어 브레인. https://console.anthropic.com/settings/keys 에서 발급 (sk-ant-...).
# 비워두면 봇은 1차 키워드 검색으로만 동작한다 — 배포는 그대로 되고, 조용해지지 않는다.
ANTHROPIC_API_KEY=

# 선택. 기본값 claude-haiku-4-5 (싸고 빠름, 이 용도엔 충분).
# 더 어려운 추론이 필요하면 claude-sonnet-5 로 바꾸면 된다.
#LLM_MODEL=

# 대상 위키 — 기본값(WoodrowDy/memories/main) 그대로면 손대지 않는다.
#WIKI_OWNER=
#WIKI_REPO=
#WIKI_BRANCH=
