# Slack — 앱 설정 두 곳에서 가져옴
# Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=
# OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=

# GitHub — 선택. 없으면 무인증 60회/시간, 넣으면 5000회/시간
# fine-grained PAT / memories repo만 / Contents: Read-only
GITHUB_TOKEN=

# 대상 위키 — 기본값 그대로면 지워도 됨
# WIKI_OWNER=WoodrowDy
# WIKI_REPO=memories
# WIKI_BRANCH=main